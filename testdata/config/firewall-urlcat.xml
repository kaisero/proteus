<config version="11.2.0" urldb="paloaltonetworks" detail-version="11.2.5">
  <shared/>
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <address>
            <entry name="net-labor"><ip-netmask>198.18.0.0/15</ip-netmask></entry>
            <entry name="fqdn-host"><fqdn>host.example.com</fqdn></entry>
            <entry name="range-host"><ip-range>198.18.5.1-198.18.5.10</ip-range></entry>
          </address>
          <service>
            <entry name="svc-pve"><protocol><tcp><port>8006</port></tcp></protocol></entry>
            <entry name="svc-dns"><protocol><udp><port>53</port></udp></protocol></entry>
            <entry name="svc-range"><protocol><tcp><port>8000-8100,9000</port></tcp></protocol></entry>
          </service>
          <service-group>
            <entry name="svc-grp"><members><member>svc-pve</member><member>svc-range</member></members></entry>
          </service-group>
          <profiles>
            <custom-url-category>
              <entry name="custom-azuresite-group">
                <list>
                  <member>superlong.example.azureapps.microsoft.com</member>
                  <member>*.wildcard-example.com</member>
                </list>
                <type>URL List</type>
              </entry>
            </custom-url-category>
          </profiles>
          <rulebase>
            <security>
              <rules>
                <entry name="any-category-early">
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <category><member>any</member></category>
                  <action>allow</action>
                </entry>
                <entry name="svc-rule">
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>svc-grp</member></service>
                  <action>allow</action>
                </entry>
                <entry name="fqdn-rule">
                  <source><member>fqdn-host</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <action>allow</action>
                </entry>
                <entry name="URL-Example">
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <category><member>custom-azuresite-group</member></category>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
