<config version="11.2.0" urldb="paloaltonetworks" detail-version="11.2.5">
  <!-- Doubts and the decision (spec §4.7). Rules 1 to 6 follow the shape of the
       fw02 rulebase: a port rule, an address rule, two application rules with
       application-default, then the rules that decide. Rules 7 to 13 are between
       dmz and wan: each sets one field no stage evaluates, or one that is not a
       matching field. Rule 14, labor to dmz, is in doubt and shares the action of
       interzone-default. -->
  <shared/>
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <zone>
            <entry name="home"/>
            <entry name="wan"/>
            <entry name="labor"/>
            <entry name="dmz"/>
          </zone>
          <address>
            <entry name="net-labor"><ip-netmask>198.18.0.0/15</ip-netmask></entry>
          </address>
          <service>
            <entry name="svc-udp-443"><protocol><udp><port>443</port></udp></protocol></entry>
          </service>
          <profiles>
            <custom-url-category>
              <entry name="my-cat"><list><member>shop.example.com</member></list><type>URL List</type></entry>
            </custom-url-category>
          </profiles>
          <rulebase>
            <security>
              <rules>
                <entry name="block-udp-443">
                  <from><member>home</member></from>
                  <to><member>wan</member></to>
                  <source><member>198.18.1.68</member></source>
                  <destination><member>any</member></destination>
                  <source-user><member>any</member></source-user>
                  <category><member>any</member></category>
                  <application><member>any</member></application>
                  <service><member>svc-udp-443</member></service>
                  <source-hip><member>any</member></source-hip>
                  <destination-hip><member>any</member></destination-hip>
                  <action>deny</action>
                </entry>
                <entry name="block-dns">
                  <from><member>home</member></from>
                  <to><member>wan</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.53</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>deny</action>
                </entry>
                <entry name="app-one">
                  <from><member>any</member></from>
                  <to><member>wan</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>dropbox</member></application>
                  <service><member>application-default</member></service>
                  <action>allow</action>
                </entry>
                <entry name="app-two">
                  <from><member>any</member></from>
                  <to><member>wan</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>zoom</member></application>
                  <service><member>application-default</member></service>
                  <action>allow</action>
                </entry>
                <entry name="to-labor">
                  <from><member>home</member></from>
                  <to><member>any</member></to>
                  <source><member>any</member></source>
                  <destination><member>net-labor</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="internet">
                  <from><member>any</member></from>
                  <to><member>wan</member></to>
                  <source><member>net-labor</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="dmz-user">
                  <from><member>dmz</member></from>
                  <to><member>wan</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <source-user><member>corp\alice</member></source-user>
                  <destination-hip><member>hip-a</member></destination-hip>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <tag><member>audit</member></tag>
                  <action>deny</action>
                </entry>
                <entry name="dmz-schedule">
                  <from><member>dmz</member></from>
                  <to><member>wan</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <schedule>work-hours</schedule>
                  <action>deny</action>
                </entry>
                <entry name="dmz-pandb">
                  <from><member>dmz</member></from>
                  <to><member>wan</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <category><member>news</member></category>
                  <action>deny</action>
                </entry>
                <entry name="dmz-custom">
                  <from><member>dmz</member></from>
                  <to><member>wan</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <category><member>my-cat</member></category>
                  <action>deny</action>
                </entry>
                <entry name="dmz-predefined">
                  <from><member>dmz</member></from>
                  <to><member>wan</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>service-https</member></service>
                  <action>deny</action>
                </entry>
                <entry name="dmz-no-service">
                  <from><member>dmz</member></from>
                  <to><member>wan</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <action>deny</action>
                </entry>
                <entry name="dmz-plain">
                  <from><member>dmz</member></from>
                  <to><member>wan</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <tag><member>audit</member></tag>
                  <action>allow</action>
                </entry>
                <entry name="labor-app">
                  <from><member>labor</member></from>
                  <to><member>dmz</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>dropbox</member></application>
                  <service><member>any</member></service>
                  <action>deny</action>
                </entry>
                <entry name="dmz-home-custom">
                  <from><member>dmz</member></from>
                  <to><member>home</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <category><member>my-cat</member></category>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
