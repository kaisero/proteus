<config detail-version="11.2.5" urldb="paloaltonetworks" version="11.2.0">
  <!-- fw01's NAT test rules (spec §18.5) with its zones and the objects they name, extracted on 2026-09-29 from the live configuration; nothing else of it. -->
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <zone>
            <entry name="server">
              <network>
                <layer3>
                  <member>ethernet1/2</member>
                </layer3>
              </network>
            </entry>
            <entry name="client">
              <network>
                <layer3>
                  <member>ethernet1/3</member>
                </layer3>
              </network>
            </entry>
            <entry name="transport">
              <network>
                <layer3>
                  <member>ethernet1/1</member>
                  <member>ethernet1/8</member>
                  <member>loopback.1</member>
                  <member>loopback.99</member>
                  <member>loopback.100</member>
                  <member>loopback.101</member>
                </layer3>
              </network>
            </entry>
            <entry name="prisma">
              <network>
                <layer3>
                  <member>tunnel.1</member>
                </layer3>
              </network>
            </entry>
            <entry name="dmz">
              <network>
                <layer3>
                  <member>ethernet1/4</member>
                </layer3>
              </network>
            </entry>
            <entry name="mgmt">
              <network>
                <layer3>
                  <member>ethernet1/5</member>
                  <member>ethernet1/9.101</member>
                </layer3>
              </network>
            </entry>
            <entry name="sdwan">
              <network>
                <layer3 />
              </network>
            </entry>
            <entry name="link-int-a">
              <network>
                <layer3>
                  <member>ethernet1/6</member>
                </layer3>
              </network>
            </entry>
            <entry name="int-link-b">
              <network>
                <layer3>
                  <member>ethernet1/7</member>
                </layer3>
              </network>
            </entry>
            <entry name="dmz-ext">
              <network>
                <layer3>
                  <member>ethernet1/9.20</member>
                </layer3>
              </network>
            </entry>
          </zone>
          <address>
            <entry name="t-fqdn">
              <fqdn>dns.google</fqdn>
            </entry>
            <entry name="t-dmz-block">
              <ip-netmask>198.18.19.0/28</ip-netmask>
            </entry>
          </address>
          <service>
            <entry name="t-8443">
              <protocol>
                <tcp>
                  <port>8443</port>
                </tcp>
              </protocol>
            </entry>
            <entry name="t-8080">
              <protocol>
                <tcp>
                  <port>8080</port>
                </tcp>
              </protocol>
            </entry>
          </service>
          <rulebase>
            <nat>
              <rules>
                <entry name="t-no-nat">
                  <from>
                    <member>client</member>
                  </from>
                  <to>
                    <member>transport</member>
                  </to>
                  <source>
                    <member>198.18.11.77</member>
                  </source>
                  <destination>
                    <member>198.18.250.0/24</member>
                  </destination>
                  <service>any</service>
                </entry>
                <entry name="t-disabled">
                  <from>
                    <member>client</member>
                  </from>
                  <to>
                    <member>transport</member>
                  </to>
                  <source>
                    <member>198.18.11.78</member>
                  </source>
                  <destination>
                    <member>198.18.250.0/24</member>
                  </destination>
                  <service>any</service>
                  <disabled>yes</disabled>
                </entry>
                <entry name="t-dnat-port">
                  <from>
                    <member>any</member>
                  </from>
                  <to>
                    <member>transport</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>198.18.250.10</member>
                  </destination>
                  <service>t-8443</service>
                  <destination-translation>
                    <translated-address>198.18.10.100</translated-address>
                    <translated-port>443</translated-port>
                  </destination-translation>
                </entry>
                <entry name="t-dnat-self">
                  <from>
                    <member>any</member>
                  </from>
                  <to>
                    <member>transport</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>198.19.0.254</member>
                  </destination>
                  <service>t-8080</service>
                  <destination-translation>
                    <translated-address>198.18.10.100</translated-address>
                    <translated-port>80</translated-port>
                  </destination-translation>
                </entry>
                <entry name="t-bidir">
                  <from>
                    <member>dmz</member>
                  </from>
                  <to>
                    <member>transport</member>
                  </to>
                  <source>
                    <member>198.18.19.50</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <service>any</service>
                  <source-translation>
                    <static-ip>
                      <translated-address>198.18.250.20</translated-address>
                      <bi-directional>yes</bi-directional>
                    </static-ip>
                  </source-translation>
                </entry>
                <entry name="t-dnat-competing">
                  <from>
                    <member>any</member>
                  </from>
                  <to>
                    <member>transport</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>198.18.250.20</member>
                  </destination>
                  <service>any</service>
                  <destination-translation>
                    <translated-address>198.18.10.101</translated-address>
                  </destination-translation>
                </entry>
                <entry name="t-static-block">
                  <from>
                    <member>dmz</member>
                  </from>
                  <to>
                    <member>transport</member>
                  </to>
                  <source>
                    <member>t-dmz-block</member>
                  </source>
                  <destination>
                    <member>198.18.250.0/24</member>
                  </destination>
                  <service>any</service>
                  <source-translation>
                    <static-ip>
                      <translated-address>198.18.250.32/28</translated-address>
                    </static-ip>
                  </source-translation>
                </entry>
                <entry name="t-pdipp">
                  <from>
                    <member>client</member>
                  </from>
                  <to>
                    <member>transport</member>
                  </to>
                  <source>
                    <member>198.18.11.0/24</member>
                  </source>
                  <destination>
                    <member>198.18.250.100</member>
                  </destination>
                  <service>any</service>
                  <source-translation>
                    <persistent-dynamic-ip-and-port>
                      <interface-address>
                        <interface>ethernet1/1</interface>
                      </interface-address>
                    </persistent-dynamic-ip-and-port>
                  </source-translation>
                </entry>
                <entry name="t-dip-pool">
                  <from>
                    <member>client</member>
                  </from>
                  <to>
                    <member>transport</member>
                  </to>
                  <source>
                    <member>198.18.11.0/24</member>
                  </source>
                  <destination>
                    <member>198.18.250.0/24</member>
                  </destination>
                  <service>any</service>
                  <source-translation>
                    <dynamic-ip>
                      <translated-address>
                        <member>198.18.250.64/29</member>
                      </translated-address>
                      <fallback>
                        <interface-address>
                          <interface>ethernet1/1</interface>
                        </interface-address>
                      </fallback>
                    </dynamic-ip>
                  </source-translation>
                </entry>
                <entry name="t-dnat-fqdn">
                  <from>
                    <member>any</member>
                  </from>
                  <to>
                    <member>transport</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>198.18.250.30</member>
                  </destination>
                  <service>any</service>
                  <dynamic-destination-translation>
                    <translated-address>t-fqdn</translated-address>
                    <distribution>round-robin</distribution>
                  </dynamic-destination-translation>
                </entry>
                <entry name="server-access">
                  <source-translation>
                    <dynamic-ip-and-port>
                      <interface-address>
                        <ip>198.18.10.1/24</ip>
                        <interface>ethernet1/2</interface>
                      </interface-address>
                    </dynamic-ip-and-port>
                  </source-translation>
                  <to>
                    <member>server</member>
                  </to>
                  <from>
                    <member>transport</member>
                  </from>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <service>any</service>
                </entry>
                <entry name="oob-mgmt-access">
                  <source-translation>
                    <dynamic-ip-and-port>
                      <interface-address>
                        <interface>ethernet1/9.101</interface>
                      </interface-address>
                    </dynamic-ip-and-port>
                  </source-translation>
                  <to>
                    <member>mgmt</member>
                  </to>
                  <from>
                    <member>any</member>
                  </from>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <service>any</service>
                  <to-interface>ethernet1/9.101</to-interface>
                </entry>
                <entry name="mgmt-access">
                  <source-translation>
                    <dynamic-ip-and-port>
                      <interface-address>
                        <ip>198.18.100.1/24</ip>
                        <interface>ethernet1/5</interface>
                      </interface-address>
                    </dynamic-ip-and-port>
                  </source-translation>
                  <to>
                    <member>mgmt</member>
                  </to>
                  <from>
                    <member>transport</member>
                  </from>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <service>any</service>
                </entry>
                <entry name="internet-a">
                  <source-translation>
                    <dynamic-ip-and-port>
                      <interface-address>
                        <interface>ethernet1/1</interface>
                      </interface-address>
                    </dynamic-ip-and-port>
                  </source-translation>
                  <to>
                    <member>transport</member>
                  </to>
                  <from>
                    <member>any</member>
                  </from>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <service>any</service>
                  <to-interface>ethernet1/1</to-interface>
                </entry>
                <entry name="internet-b">
                  <source-translation>
                    <dynamic-ip-and-port>
                      <interface-address>
                        <interface>ethernet1/8</interface>
                      </interface-address>
                    </dynamic-ip-and-port>
                  </source-translation>
                  <to>
                    <member>transport</member>
                  </to>
                  <from>
                    <member>any</member>
                  </from>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>any</member>
                  </destination>
                  <service>any</service>
                  <to-interface>ethernet1/8</to-interface>
                </entry>
              </rules>
            </nat>
            <security>
              <rules>
                <entry name="t-allow-8443">
                  <from>
                    <member>transport</member>
                  </from>
                  <to>
                    <member>server</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>198.18.250.10</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>t-8443</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="t-allow-443">
                  <from>
                    <member>transport</member>
                  </from>
                  <to>
                    <member>server</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>198.18.250.10</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>service-https</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
                <entry name="t-allow-bidir">
                  <from>
                    <member>transport</member>
                  </from>
                  <to>
                    <member>dmz</member>
                    <member>server</member>
                  </to>
                  <source>
                    <member>any</member>
                  </source>
                  <destination>
                    <member>198.18.250.20</member>
                  </destination>
                  <application>
                    <member>any</member>
                  </application>
                  <service>
                    <member>any</member>
                  </service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
