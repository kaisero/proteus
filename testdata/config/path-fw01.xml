<config version="11.2.0" urldb="paloaltonetworks" detail-version="11.2.5">
  <!-- fw01 of the path fixture, derived from firewall-lab.xml: zones transport
       (ethernet1/1) and server (ethernet1/2), with 198.18.10.0/24 connected.
       Zones and addresses match testdata/opdata/fw01-interface-all.xml. No
       security rule and no pushed rule, so the default rules decide. -->
  <shared/>
  <devices>
    <entry name="localhost.localdomain">
      <network>
        <interface>
          <ethernet>
            <entry name="ethernet1/1"><layer3><ip><entry name="198.19.0.254/24"/></ip></layer3></entry>
            <entry name="ethernet1/2"><layer3><ip><entry name="198.18.10.1/24"/></ip></layer3></entry>
          </ethernet>
        </interface>
        <logical-router>
          <entry name="default">
            <vrf>
              <entry name="default">
                <interface><member>ethernet1/1</member><member>ethernet1/2</member></interface>
              </entry>
            </vrf>
          </entry>
        </logical-router>
      </network>
      <vsys>
        <entry name="vsys1">
          <zone>
            <entry name="transport"><network><layer3><member>ethernet1/1</member></layer3></network></entry>
            <entry name="server"><network><layer3><member>ethernet1/2</member></layer3></network></entry>
          </zone>
          <address>
            <entry name="dc01"><ip-netmask>198.18.10.100</ip-netmask></entry>
          </address>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
