<config version="11.2.0" urldb="paloaltonetworks" detail-version="11.2.5">
  <shared/>
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <local-user-database>
            <user>
              <entry name="alice"><phash>x</phash></entry>
              <entry name="bob"><phash>y</phash></entry>
            </user>
            <user-group>
              <entry name="local-admins">
                <user><member>alice</member></user>
              </entry>
            </user-group>
          </local-user-database>
          <dynamic-user-group>
            <entry name="quarantined-users">
              <filter>'compromised'</filter>
            </entry>
          </dynamic-user-group>
          <rulebase>
            <security>
              <rules>
                <entry name="admins-allowed">
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <source-user><member>local-admins</member></source-user>
                  <action>allow</action>
                </entry>
                <entry name="engineering-allowed">
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <source-user><member>engineering</member></source-user>
                  <action>allow</action>
                </entry>
                <entry name="quarantine-deny">
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <source-user><member>quarantined-users</member></source-user>
                  <action>deny</action>
                </entry>
                <entry name="bob-direct">
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <source-user><member>bob</member></source-user>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
