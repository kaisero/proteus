<config version="11.2.0" urldb="paloaltonetworks" detail-version="11.2.5">
  <shared/>
  <devices>
    <entry name="localhost.localdomain">
      <network>
        <interface>
          <ethernet>
            <entry name="ethernet1/1"><layer3><ip><entry name="10.1.0.1/24"/></ip></layer3></entry>
            <entry name="ethernet1/2"><layer3><ip><entry name="10.2.0.1/24"/></ip></layer3></entry>
            <entry name="ethernet1/3"><layer3><ip><entry name="10.3.0.1/24"/></ip></layer3></entry>
          </ethernet>
        </interface>
      </network>
      <vsys>
        <entry name="vsys1">
          <zone>
            <entry name="inside"><network><layer3><member>ethernet1/1</member></layer3></network></entry>
            <entry name="dmz"><network><layer3><member>ethernet1/2</member></layer3></network></entry>
            <entry name="out"><network><layer3><member>ethernet1/3</member></layer3></network></entry>
          </zone>
          <rulebase>
            <security>
              <rules>
                <entry name="intra-inside">
                  <from><member>inside</member></from>
                  <to><member>dmz</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <rule-type>intrazone</rule-type>
                  <action>allow</action>
                </entry>
                <entry name="inter-inside">
                  <from><member>inside</member></from>
                  <to><member>inside</member><member>dmz</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <rule-type>interzone</rule-type>
                  <action>deny</action>
                </entry>
                <entry name="universal-out">
                  <from><member>out</member></from>
                  <to><member>out</member><member>dmz</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
