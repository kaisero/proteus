<config version="11.2.0" urldb="paloaltonetworks" detail-version="11.2.5">
  <!-- User-ID fixture (spec 2026-10-17). Every value is a dummy. It pairs with
       testdata/identity/identity.json. Each rule goes from inside to outside, to
       its own destination, and names the source-user form of one fact: a user,
       a UPN, LDAP, XML API and dynamic user groups, a group DN in another case
       (M11), a short name (M12), groups without members (M13), a CIE group (D1),
       an outside user (M17), the keywords, no source-user at all, and a local
       group. -->
  <shared/>
  <devices>
    <entry name="localhost.localdomain">
      <network>
        <interface>
          <ethernet>
            <entry name="ethernet1/1">
              <layer3><ip><entry name="198.51.100.1/24"/></ip></layer3>
            </entry>
            <entry name="ethernet1/2">
              <layer3><ip><entry name="192.0.2.1/24"/></ip></layer3>
            </entry>
          </ethernet>
        </interface>
      </network>
      <vsys>
        <entry name="vsys1">
          <import>
            <network>
              <interface><member>ethernet1/1</member><member>ethernet1/2</member></interface>
            </network>
          </import>
          <zone>
            <entry name="inside"><network><layer3><member>ethernet1/1</member></layer3></network></entry>
            <entry name="outside"><network><layer3><member>ethernet1/2</member></layer3></network></entry>
          </zone>
          <address>
            <entry name="web-server"><ip-netmask>192.0.2.80</ip-netmask></entry>
          </address>
          <tag>
            <entry name="tag-a"/>
            <entry name="tag-b"/>
          </tag>
          <local-user-database>
            <user>
              <entry name="alice"><phash>x</phash></entry>
            </user>
            <user-group>
              <entry name="local-admins">
                <user><member>alice</member></user>
              </entry>
            </user-group>
          </local-user-database>
          <dynamic-user-group>
            <entry name="dug-a">
              <filter>'tag-a'</filter>
            </entry>
            <entry name="dug-ab">
              <filter>'tag-a' and 'tag-b'</filter>
            </entry>
          </dynamic-user-group>
          <rulebase>
            <security>
              <rules>
                <entry name="u-ldap-group">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.10</member></destination>
                  <source-user><member>cn=domain users,cn=users,dc=example,dc=com</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-user">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.11</member></destination>
                  <source-user><member>example.com\alice</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-upn">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.12</member></destination>
                  <source-user><member>alice@example.com</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-known">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.13</member></destination>
                  <source-user><member>known-user</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-unknown">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.14</member></destination>
                  <source-user><member>unknown</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>deny</action>
                </entry>
                <entry name="u-prelogon">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.15</member></destination>
                  <source-user><member>pre-logon</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-xmlapi">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.16</member></destination>
                  <source-user><member>engineering</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-dug">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.17</member></destination>
                  <source-user><member>dug-a</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-multi">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.18</member></destination>
                  <source-user><member>cn=payroll,ou=groups,dc=example,dc=com</member><member>example.com\bob</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>deny</action>
                </entry>
                <entry name="u-dn-case">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.19</member></destination>
                  <source-user><member>CN=Domain Users,CN=Users,DC=example,DC=com</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-short">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.20</member></destination>
                  <source-user><member>example.com\domain users</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-empty">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.21</member></destination>
                  <source-user><member>cn=empty,ou=groups,dc=example,dc=com</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-no-group">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.22</member></destination>
                  <source-user><member>cn=no-such,ou=groups,dc=example,dc=com</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-dug-ab">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.23</member></destination>
                  <source-user><member>dug-ab</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-cie">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.24</member></destination>
                  <source-user><member>example-cie\cloud-team</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-ghost">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.25</member></destination>
                  <source-user><member>other\ghost</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-none">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.26</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
                <entry name="u-local">
                  <from><member>inside</member></from>
                  <to><member>outside</member></to>
                  <source><member>any</member></source>
                  <destination><member>192.0.2.27</member></destination>
                  <source-user><member>local-admins</member></source-user>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
