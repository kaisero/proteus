<config version="11.2.0" urldb="paloaltonetworks" detail-version="11.2.5">
  <shared/>
  <devices>
    <entry name="localhost.localdomain">
      <network>
        <interface>
          <ethernet>
            <entry name="ethernet1/1">
              <layer3><ip><entry name="10.50.0.1/24"/></ip></layer3>
            </entry>
          </ethernet>
        </interface>
        <virtual-router>
          <entry name="default">
            <routing-table>
              <ip>
                <static-route>
                  <entry name="same-prefix">
                    <destination>10.50.0.0/24</destination>
                    <interface>ethernet1/1</interface>
                  </entry>
                </static-route>
              </ip>
            </routing-table>
          </entry>
        </virtual-router>
      </network>
      <vsys>
        <entry name="vsys1">
          <zone>
            <entry name="zone-a"><network><layer3><member>ethernet1/1</member></layer3></network></entry>
            <entry name="zone-b"><network><layer3><member>ethernet1/1</member></layer3></network></entry>
          </zone>
          <rulebase>
            <security>
              <rules>
                <entry name="r1">
                  <from><member>zone-a</member></from>
                  <to><member>any</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
