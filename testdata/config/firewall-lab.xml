<config version="11.2.0" urldb="paloaltonetworks" detail-version="11.2.5">
  <shared>
    <address>
      <entry name="shared-dns"><ip-netmask>9.9.9.9/32</ip-netmask></entry>
    </address>
    <pre-rulebase><security><rules>
      <entry name="pushed-pre"><action>allow</action>
        <source><member>any</member></source></entry>
    </rules></security></pre-rulebase>
    <post-rulebase><security><rules>
      <entry name="pushed-post"><action>deny</action>
        <source><member>any</member></source></entry>
    </rules></security></post-rulebase>
  </shared>
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <address>
            <entry name="net-home"><ip-netmask>198.18.1.0/24</ip-netmask></entry>
            <entry name="net-labor"><ip-netmask>198.18.0.0/15</ip-netmask></entry>
            <entry name="dc01"><ip-netmask>198.18.10.100</ip-netmask>
              <tag><member>server</member></tag></entry>
          </address>
          <address-group>
            <entry name="g-servers"><static><member>dc01</member></static></entry>
            <entry name="g-tagged"><dynamic><filter>'server'</filter></dynamic></entry>
          </address-group>
          <rulebase>
            <security>
              <rules>
                <entry name="identity-redistribution">
                  <source><member>any</member></source>
                  <destination><member>10.10.0.0/24</member></destination>
                  <application><member>any</member></application>
                  <action>allow</action>
                </entry>
                <entry name="dc-to-home">
                  <source><member>g-servers</member></source>
                  <destination><member>net-home</member></destination>
                  <application><member>ssl</member></application>
                  <action>allow</action>
                </entry>
                <entry name="tagged-out">
                  <source><member>g-tagged</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <action>allow</action>
                  <disabled>yes</disabled>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
        <entry name="vsys2">
          <address>
            <entry name="net-dmz"><ip-netmask>198.19.0.0/16</ip-netmask></entry>
          </address>
          <rulebase>
            <security>
              <rules>
                <entry name="dmz-out">
                  <source><member>net-dmz</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
