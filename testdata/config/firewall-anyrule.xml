<config version="11.2.0" urldb="paloaltonetworks" detail-version="11.2.5">
  <shared/>
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <address>
            <entry name="net-labor"><ip-netmask>198.18.0.0/15</ip-netmask></entry>
            <entry name="net-home"><ip-netmask>198.18.1.0/24</ip-netmask></entry>
          </address>
          <rulebase>
            <security>
              <rules>
                <entry name="any-early">
                  <source><member>any</member></source>
                  <destination><member>net-labor</member></destination>
                  <application><member>any</member></application>
                  <action>allow</action>
                </entry>
                <entry name="specific-late">
                  <source><member>net-labor</member></source>
                  <destination><member>net-home</member></destination>
                  <application><member>any</member></application>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
