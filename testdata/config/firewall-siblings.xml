<config version="11.2.0" urldb="paloaltonetworks" detail-version="11.2.5">
  <!-- Two sibling vsys holding an object of the same name, and one shared object
       both can see. A reference index for either must show its own edge and the
       shared one, and never its sibling's. -->
  <shared>
    <address>
      <entry name="everywhere"><ip-netmask>10.0.0.1/32</ip-netmask></entry>
    </address>
  </shared>
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <address>
            <entry name="both-sides"><ip-netmask>10.1.0.0/24</ip-netmask></entry>
          </address>
          <rulebase><security><rules>
            <entry name="left-rule">
              <source><member>both-sides</member></source>
              <destination><member>everywhere</member></destination>
              <application><member>any</member></application>
              <action>allow</action>
            </entry>
          </rules></security></rulebase>
        </entry>
        <entry name="vsys2">
          <address>
            <entry name="both-sides"><ip-netmask>10.2.0.0/24</ip-netmask></entry>
          </address>
          <rulebase><security><rules>
            <entry name="right-rule">
              <source><member>both-sides</member></source>
              <destination><member>everywhere</member></destination>
              <application><member>any</member></application>
              <action>allow</action>
            </entry>
          </rules></security></rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
