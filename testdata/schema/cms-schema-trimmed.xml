<?xml version="1.0"?>
<sequence name="config" forward-compatible="no">
  <sequence name="readonly" tlo="yes" optional="yes" internal="yes" hidden="yes" skip-validation="yes">
  </sequence>
  <sequence name="shared" optional="yes">
    <array name="address" optional="yes">
      <sequence name="entry">
        <attr-req name="name" type="string" maxlen="63"/>
        <element name="description" optional="yes" type="string" maxlen="1023" help-string="Description"/>
        <choice optional="no">
          <element name="ip-netmask" type="string" help-string="IP address or netmask"/>
          <element name="ip-range" type="string" help-string="IP range"/>
          <element name="fqdn" type="string" maxlen="255" help-string="Fully qualified domain name"/>
        </choice>
        <array name="tag" optional="yes">
          <element name="member" type="string" maxlen="127">
            <memberof>#config/shared/tag/entry/@name</memberof>
          </element>
        </array>
      </sequence>
    </array>
    <array name="address-group" optional="yes">
      <sequence name="entry">
        <attr-req name="name" type="string" maxlen="63"/>
        <element name="description" optional="yes" type="string" maxlen="1023"/>
        <choice>
          <array name="static" optional="yes">
            <element name="member" type="string" maxlen="63">
              <memberof>#config/shared/address/entry/@name</memberof>
              <memberof>#config/shared/address-group/entry/@name</memberof>
            </element>
          </array>
          <sequence name="dynamic" optional="yes">
            <element name="filter" type="string" maxlen="2047" help-string="Tag-based filter"/>
          </sequence>
        </choice>
      </sequence>
    </array>
    <array name="tag" optional="yes">
      <sequence name="entry">
        <attr-req name="name" type="string" maxlen="127"/>
        <element name="color" optional="yes" type="enum">
          <enum value="color1"/>
          <enum value="color2"/>
        </element>
        <element name="comments" optional="yes" type="string" maxlen="1023"/>
      </sequence>
    </array>
    <sequence name="pre-rulebase" optional="yes">
      <sequence name="security" optional="yes">
        <array name="rules" optional="yes">
          <sequence name="entry">
            <attr-req name="name" type="string" maxlen="63"/>
            <element name="action" type="enum" default="allow" help-string="Action to take">
              <enum value="allow"/>
              <enum value="deny"/>
              <enum value="drop"/>
            </element>
            <element name="disabled" optional="yes" type="bool" default="no"/>
            <array name="source" optional="yes">
              <element name="member" type="string" maxlen="63">
                <memberof>#config/shared/address/entry/@name</memberof>
                <memberof>#config/shared/address-group/entry/@name</memberof>
              </element>
            </array>
            <array name="destination" optional="yes">
              <element name="member" type="string" maxlen="63">
                <memberof>#config/shared/address/entry/@name</memberof>
                <memberof>#config/shared/address-group/entry/@name</memberof>
              </element>
            </array>
            <array name="application" optional="yes">
              <element name="member" type="string" maxlen="63"/>
            </array>
          </sequence>
        </array>
      </sequence>
    </sequence>
    <sequence name="post-rulebase" optional="yes">
      <sequence name="security" optional="yes">
        <array name="rules" optional="yes">
          <sequence name="entry">
            <attr-req name="name" type="string" maxlen="63"/>
            <element name="action" type="enum" default="allow"/>
            <element name="disabled" optional="yes" type="bool" default="no"/>
            <array name="source" optional="yes">
              <element name="member" type="string" maxlen="63"/>
            </array>
            <array name="destination" optional="yes">
              <element name="member" type="string" maxlen="63"/>
            </array>
            <array name="application" optional="yes">
              <element name="member" type="string" maxlen="63"/>
            </array>
          </sequence>
        </array>
      </sequence>
    </sequence>
    <array name="headers" optional="yes">
      <sequence name="entry">
        <attr-req name="name" type="string" maxlen="63"/>
        <element name="value" optional="yes" type="string" maxlen="1023"/>
      </sequence>
    </array>
  </sequence>
  <sequence name="devices" optional="yes">
    <sequence name="entry">
      <attr-req name="name" type="string" maxlen="64"/>
      <array name="device-group" apply_unused="yes" optional="yes">
        <sequence name="entry">
          <attr-req name="name" type="string" maxlen="31"/>
          <element name="description" optional="yes" type="string" maxlen="255"/>
          <array name="reference-templates" optional="yes">
            <element name="member" type="string" maxlen="64"/>
          </array>
          <array name="devices" optional="yes" help-string="device serial numbers">
            <sequence name="entry" skip-push-validation="yes">
              <attr-req name="name" type="string" maxlen="64" regex="^[0-9A-Z]+$" help-string="device name"/>
              <array name="vsys" optional="yes">
                <sequence name="entry">
                  <attr-req name="name" type="string" subtype="object-name"/>
                </sequence>
              </array>
            </sequence>
          </array>
          <array name="address" optional="yes">
            <sequence name="entry">
              <attr-req name="name" type="string" maxlen="63"/>
              <element name="description" optional="yes" type="string" maxlen="1023"/>
              <choice optional="no">
                <element name="ip-netmask" type="string"/>
                <element name="ip-range" type="string"/>
                <element name="fqdn" type="string" maxlen="255"/>
              </choice>
              <array name="tag" optional="yes">
                <element name="member" type="string" maxlen="127"/>
              </array>
            </sequence>
          </array>
          <array name="params" optional="yes">
            <sequence name="entry">
              <attr-req name="name" type="string" maxlen="63"/>
              <element name="value" optional="yes" type="string" maxlen="1023"/>
            </sequence>
          </array>
          <sequence name="pre-rulebase" optional="yes">
            <sequence name="security" optional="yes">
              <array name="rules" optional="yes">
                <sequence name="entry">
                  <attr-req name="name" type="string" maxlen="63"/>
                  <element name="action" type="enum" default="allow"/>
                  <element name="disabled" optional="yes" type="bool" default="no"/>
                  <array name="source" optional="yes">
                    <element name="member" type="string" maxlen="63"/>
                  </array>
                  <array name="destination" optional="yes">
                    <element name="member" type="string" maxlen="63"/>
                  </array>
                  <array name="application" optional="yes">
                    <element name="member" type="string" maxlen="63"/>
                  </array>
                </sequence>
              </array>
            </sequence>
          </sequence>
          <sequence name="post-rulebase" optional="yes">
            <sequence name="security" optional="yes">
              <array name="rules" optional="yes">
                <sequence name="entry">
                  <attr-req name="name" type="string" maxlen="63"/>
                  <element name="action" type="enum" default="allow"/>
                  <element name="disabled" optional="yes" type="bool" default="no"/>
                  <array name="source" optional="yes">
                    <element name="member" type="string" maxlen="63"/>
                  </array>
                  <array name="destination" optional="yes">
                    <element name="member" type="string" maxlen="63"/>
                  </array>
                  <array name="application" optional="yes">
                    <element name="member" type="string" maxlen="63"/>
                  </array>
                </sequence>
              </array>
            </sequence>
          </sequence>
        </sequence>
      </array>
      <array name="template" optional="yes">
        <sequence name="entry">
          <attr-req name="name" type="string" maxlen="63"/>
          <element name="description" optional="yes" type="string" maxlen="255"/>
        </sequence>
      </array>
      <array name="template-stack" optional="yes">
        <sequence name="entry">
          <attr-req name="name" type="string" maxlen="63"/>
          <array name="templates" optional="yes">
            <element name="member" type="string" maxlen="63"/>
          </array>
          <array name="devices" optional="yes">
            <sequence name="entry">
              <attr-req name="name" type="string" maxlen="64"/>
            </sequence>
          </array>
        </sequence>
      </array>
    </sequence>
  </sequence>
</sequence>
