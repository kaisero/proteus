<config version="11.2.0" urldb="paloaltonetworks" detail-version="11.2.5">
  <!-- Configured services with predefined names (lab fact L7). vsys1 defines
       service-https as tcp/8443 and shared defines service-http as tcp/8081, so
       each hides the predefined service of its name. The NAT rules are those of
       testdata/predefined/config.xml. -->
  <shared>
    <service>
      <entry name="service-http"><protocol><tcp><port>8081</port></tcp></protocol></entry>
    </service>
  </shared>
  <devices>
    <entry name="localhost.localdomain">
      <vsys>
        <entry name="vsys1">
          <zone>
            <entry name="home"/>
            <entry name="wan"/>
          </zone>
          <service>
            <entry name="service-https"><protocol><tcp><port>8443</port></tcp></protocol></entry>
          </service>
          <rulebase>
            <nat>
              <rules>
                <entry name="dnat-https">
                  <from><member>home</member></from><to><member>wan</member></to>
                  <source><member>any</member></source><destination><member>10.88.10.100</member></destination>
                  <service>service-https</service>
                  <destination-translation><translated-address>10.88.20.1</translated-address></destination-translation>
                </entry>
                <entry name="dnat-http">
                  <from><member>home</member></from><to><member>wan</member></to>
                  <source><member>any</member></source><destination><member>10.88.10.100</member></destination>
                  <service>service-http</service>
                  <destination-translation><translated-address>10.88.20.2</translated-address></destination-translation>
                </entry>
              </rules>
            </nat>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
