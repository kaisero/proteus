#!/bin/sh
# Pre-commit gate: formatting, linters, and unit tests must pass before a commit.
#
# Enable once per clone with:   make hooks   (sets core.hooksPath=.githooks)
# Bypass in an emergency with:  git commit --no-verify
#
# This runs the same `make gate` that CI runs, so what passes here passes there.
# If the linters aren't installed yet, run `make tools` first.
exec make gate
