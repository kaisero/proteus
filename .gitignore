/bin/
/coverage.out

# Vendor schema files pulled off an appliance. Redistribution is unresolved,
# so they stay out of git until that question is answered. See ARCHITECTURE.md.
# schemas/out/ holds proteus's own generated JSON schemas and is committed.
/schemas/*
!/schemas/out/

# internal/config/schemadigest/ is committed, not ignored. It is the only copy of
# the digests: go:embed reads them there, and the generator reads them there too.

# A local inventory holds credentials or names the variables that do.
config.yaml

# Local clutter and live device data. A fetched configuration holds addresses and
# secrets and must never be committed by mistake.
.DS_Store
*.swp
.swp
/fw-live.xml

# The real values of the App-ID lab placeholders: lab addresses stay out of git.
/docs/lab/app-id-lab.vars
# The real values of every other lab, such as the configuration switch and the
# User-ID lab: lab users, groups and addresses stay out of git too.
/docs/lab/*.vars
# The real values of the User-ID lab placeholders, named for its lab check.
/docs/lab/user-id-lab.vars

# Zensical build output.
/site/

# Build output: the CLI binary and compiled test binaries.
/dist/
/proteus
*.test
