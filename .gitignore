/coverage.out

# Vendor schema files pulled off an appliance. Redistribution is unresolved,
# so they stay out of git until that question is answered. See ARCHITECTURE.md.
/schemas/

# config/schemadigest/ is committed, not ignored. go:embed cannot reach outside its
# own package, so the digests have to sit there for the library to compile at all. A
# pristine checkout without them does not build, which means neither does a consumer
# that runs go get. The Makefile keeps the copy in step with schemadigest/ and
# digest-check verifies it.

# A local inventory holds credentials or names the variables that do.
config.yaml
